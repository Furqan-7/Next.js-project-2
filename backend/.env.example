# --- Core ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/jobpilot
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-long-random-string
ENCRYPTION_KEY=change-me-too-used-for-oauth-tokens-at-rest
APP_URL=http://localhost:3000        # the Next.js app
API_URL=http://localhost:3001        # public URL of this API (OAuth callbacks, tracking pixel, webhooks)
PORT=3001
# Run the send/reminder ticks inside the API process (no separate worker needed for local dev)
RUN_SCHEDULER_INLINE=false

# --- AI (Claude). Without a key every feature still works using rule-based fallbacks. ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Gmail (OAuth + Pub/Sub reply tracking) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PUBSUB_TOPIC=                  # projects/<project>/topics/<topic>, push endpoint: $API_URL/api/webhooks/gmail?token=...
GOOGLE_PUBSUB_VERIFICATION_TOKEN=

# --- Outlook / Microsoft 365 (OAuth + Graph webhooks) ---
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
OUTLOOK_WEBHOOK_CLIENT_STATE=change-me

# --- Optional data sources ---
GITHUB_TOKEN=                         # raises GitHub API rate limits for enrichment + people finder
X_BEARER_TOKEN=                       # X API v2 recent search for "we're hiring" posts
APOLLO_API_KEY=                       # optional people data provider
HUNTER_API_KEY=                       # optional email pattern provider
DISCOVERY_COMPANIES=                  # e.g. greenhouse:stripe,lever:plaid,ashby:linear

# --- Notifications ---
VAPID_PUBLIC_KEY=                     # npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=                 # whatsapp:+14155238886

# --- Misc ---
CAL_COM_LINK=                         # your booking link, suggested in replies
SMTP_VERIFY_FROM=verify@yourdomain.com
SMTP_VERIFY_ENABLED=true              # many hosts block outbound port 25; results then show "unknown"
