{
  "manifest_version": 3,
  "name": "JobPilot",
  "version": "0.1.0",
  "description": "On any careers page or profile: find the right person's email and draft a personal message.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "JobPilot"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://*/*"
  ],
  "icons": {
    "128": "icon.svg"
  },
  "options_page": "options.html"
}
